            <mxCell textPosition="center" relative="1" wrapping="0" closable="0" connectable="0" value="Predicție OK" style="fontSize=10;edgeLabel;html=1;" vertex="1" parent="trans4">
              <mxGeometry x="-0.5" y="-10" relative="1" as="geometry" />
