        <!-- Legend/Title -->
        <mxCell id="title" value="State Machine: CAD Parts Classifier (Flask + CNN)" style="text;html=1;align=left;verticalAlign=top;fontSize=16;fontStyle=bold;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="50" y="20" width="500" height="30" as="geometry" />
