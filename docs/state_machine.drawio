          <mxEdgeLabel offset="0" relative="1" align="top" verticalAlign="bottom">
            <mxCell textPosition="center" relative="1" wrapping="0" closable="0" connectable="0" value="File uploadat" style="fontSize=10;edgeLabel;html=1;" vertex="1" parent="trans1">
              <mxGeometry x="-0.5" y="-10" relative="1" as="geometry" />
            </mxCell>
          </mxEdgeLabel>
        </mxCell>

        <!-- Transitions: ACQUIRE_DATA → PREPROCESS -->
        <mxCell id="trans2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="acquire_state" target="preprocess_state">
          <mxGeometry relative="1" as="geometry" />
          <mxEdgeLabel offset="0" relative="1" align="top" verticalAlign="bottom">
            <mxCell textPosition="center" relative="1" wrapping="0" closable="0" connectable="0" value="Validat OK" style="fontSize=10;edgeLabel;html=1;" vertex="1" parent="trans2">
              <mxGeometry x="-0.5" y="-10" relative="1" as="geometry" />
            </mxCell>
          </mxEdgeLabel>
        </mxCell>

        <!-- Transitions: PREPROCESS → INFERENCE -->
