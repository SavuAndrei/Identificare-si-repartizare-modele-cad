  <diagram id="state_machine_cad" name="State Machine - CAD Classifier">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- IDLE State -->
        <mxCell id="idle_state" value="IDLE&#xa;Așteptare input" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=12;fontStyle=bold;" vertex="1" parent="1">
          <mxGeometry x="50" y="300" width="120" height="120" as="geometry" />
        </mxCell>

        <!-- ACQUIRE_DATA State -->
        <mxCell id="acquire_state" value="ACQUIRE_DATA&#xa;Upload fișier" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4e6f1;strokeColor=#3498db;strokeWidth=2;fontSize=12;fontStyle=bold;" vertex="1" parent="1">
          <mxGeometry x="250" y="300" width="140" height="120" as="geometry" />
        </mxCell>

        <!-- PREPROCESS State -->
        <mxCell id="preprocess_state" value="PREPROCESS&#xa;Normalizare 32x32" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4e6f1;strokeColor=#3498db;strokeWidth=2;fontSize=12;fontStyle=bold;" vertex="1" parent="1">
          <mxGeometry x="450" y="300" width="140" height="120" as="geometry" />
        </mxCell>

        <!-- INFERENCE State -->
        <mxCell id="inference_state" value="INFERENCE&#xa;Forward pass CNN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5e6;strokeColor=#f39c12;strokeWidth=2;fontSize=12;fontStyle=bold;" vertex="1" parent="1">
          <mxGeometry x="650" y="300" width="140" height="120" as="geometry" />
        </mxCell>

        <!-- DECISION State -->
        <mxCell id="decision_state" value="DECISION&#xa;Argmax + threshold" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fdeaa8;strokeColor=#f1c40f;strokeWidth=2;fontSize=11;fontStyle=bold;" vertex="1" parent="1">
          <mxGeometry x="850" y="280" width="140" height="160" as="geometry" />
        </mxCell>

        <!-- OUTPUT/RESPONSE State -->
        <mxCell id="output_state" value="OUTPUT/RESPONSE&#xa;Return JSON" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f4e6;strokeColor=#27ae60;strokeWidth=2;fontSize=12;fontStyle=bold;" vertex="1" parent="1">
          <mxGeometry x="650" y="520" width="140" height="120" as="geometry" />
        </mxCell>

        <!-- CLEANUP State -->
