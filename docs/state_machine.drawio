          <mxGeometry x="450" y="520" width="140" height="120" as="geometry" />
        </mxCell>

        <!-- ERROR State -->
        <mxCell id="error_state" value="ERROR&#xa;Exception handler" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fadbd8;strokeColor=#e74c3c;strokeWidth=2;fontSize=12;fontStyle=bold;" vertex="1" parent="1">
          <mxGeometry x="250" y="520" width="140" height="120" as="geometry" />
        </mxCell>

        <!-- Transitions: IDLE → ACQUIRE_DATA -->
        <mxCell id="trans1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="idle_state" target="acquire_state">
          <mxGeometry relative="1" as="geometry">
