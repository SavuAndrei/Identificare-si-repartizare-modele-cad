        <!-- Transitions: INFERENCE → DECISION -->
        <mxCell id="trans4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor:#333333;" edge="1" parent="1" source="inference_state" target="decision_state">
          <mxGeometry relative="1" as="geometry" />
