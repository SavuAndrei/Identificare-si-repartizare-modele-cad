        <!-- Transitions: DECISION → OUTPUT (High confidence) -->
        <mxCell id="trans5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#27ae60;" edge="1" parent="1" source="decision_state" target="output_state">
          <mxGeometry relative="1" as="geometry">
