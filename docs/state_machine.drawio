          </mxGeometry>
          <mxEdgeLabel offset="0" relative="1" align="top" verticalAlign="bottom">
            <mxCell textPosition="center" relative="1" wrapping="0" closable="0" connectable="0" value="Confidence &lt;70%" style="fontSize=10;edgeLabel;html=1;fontColor=#e74c3c;fontStyle=bold;" vertex="1" parent="trans6">
              <mxGeometry x="0" y="20" relative="1" as="geometry" />
            </mxCell>
          </mxEdgeLabel>
