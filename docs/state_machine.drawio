            <mxCell textPosition="center" relative="1" wrapping="0" closable="0" connectable="0" value="Features ready" style="fontSize=10;edgeLabel;html=1;" vertex="1" parent="trans3">
              <mxGeometry x="-0.5" y="-10" relative="1" as="geometry" />
            </mxCell>
          </mxEdgeLabel>
