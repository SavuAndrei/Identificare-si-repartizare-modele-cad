          <mxEdgeLabel offset="0" relative="1" align="top" verticalAlign="bottom">
            <mxCell textPosition="center" relative="1" wrapping="0" closable="0" connectable="0" value="Confidence ≥70%" style="fontSize=10;edgeLabel;html=1;fontColor=#27ae60;fontStyle=bold;" vertex="1" parent="trans5">
              <mxGeometry x="0" y="-20" relative="1" as="geometry" />
            </mxCell>
          </mxEdgeLabel>
        </mxCell>

        <!-- Transitions: DECISION → ERROR (Low confidence) -->
