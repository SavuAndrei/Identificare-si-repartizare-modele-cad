        <!-- Legend Box -->
        <mxCell id="legend" value="Solid → Normal flow&#xa;Dashed → Error/Recovery&#xa;Green → Success path&#xa;Red → Error path" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#666666;spacing=3;spacingTop=3;" vertex="1" parent="1">
